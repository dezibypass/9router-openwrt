#!/bin/sh
# 9router-reset-password <newpassword> [datadir]
# Reset dashboard password tanpa CLI / tanpa sqlite3 binary.
# Pakai node + better-sqlite3 + bcryptjs yang sudah ikut paket 9router.
NEW_PW="$1"
DATA_DIR="$2"
[ -z "$DATA_DIR" ] && DATA_DIR="$(uci get 9router.main.data_dir 2>/dev/null)"
[ -z "$DATA_DIR" ] && DATA_DIR="/mnt/data/9router-data"
[ -z "$NEW_PW" ] && { echo "Usage: $0 <newpassword> [datadir]"; exit 1; }
[ ${#NEW_PW} -lt 4 ] && { echo "password minimal 4 karakter"; exit 1; }
DB="$DATA_DIR/db/data.sqlite"
[ -f "$DB" ] || { echo "DB not found: $DB"; exit 1; }
# stop dulu biar WAL tidak korup
/etc/init.d/9router stop >/dev/null 2>&1
sleep 2
rm -f "$DB-wal" "$DB-shm" "$DATA_DIR/db/data.sqlite-wal" "$DATA_DIR/db/data.sqlite-shm"
node -e '
const dbPath=process.argv[1];
const newPw=process.argv[2];
function tryRequire(paths){ for(const p of paths){ try{ return require(p);}catch(e){} } return null; }
const b=tryRequire(["bcryptjs","/mnt/data/9router/lib/node_modules/bcryptjs","/mnt/data/9router/node_modules/bcryptjs","/mnt/data/9router/lib/node_modules/9router/app/node_modules/bcryptjs","/usr/share/9router/app/node_modules/bcryptjs","/usr/share/9router/node_modules/bcryptjs","/mnt/data/9router/lib/node_modules/9router/node_modules/bcryptjs"]);
if(!b){ console.error("bcryptjs not found, jalankan: npm i -g bcryptjs --prefix /mnt/data/9router"); process.exit(2); }
const driver=tryRequire(["better-sqlite3","/mnt/data/9router/lib/node_modules/better-sqlite3","/mnt/data/9router/lib/node_modules/9router/app/node_modules/better-sqlite3","/usr/share/9router/node_modules/better-sqlite3","/usr/share/9router/app/node_modules/better-sqlite3"]);
if(!driver){ console.error("better-sqlite3 not found"); process.exit(3); }
const hash=b.hashSync(newPw,10);
const db=driver(dbPath);
let row=null;
try{ row=db.prepare("SELECT data FROM settings WHERE id=1").get(); }catch(e){ console.error("read fail:"+e.message); process.exit(4); }
let j={};
if(row && row.data){ try{ j=JSON.parse(row.data);}catch(e){ j={}; } }
j.password=hash;
const s=JSON.stringify(j);
if(row) db.prepare("UPDATE settings SET data=? WHERE id=1").run(s);
else db.prepare("INSERT INTO settings(id,data) VALUES(1,?)").run(s);
db.close();
console.log("password updated: "+dbPath);
' "$DB" "$NEW_PW"
RC=$?
/etc/init.d/9router start >/dev/null 2>&1
[ $RC -eq 0 ] && echo "OK, silakan login http://$(uci get network.lan.ipaddr 2>/dev/null || echo 192.168.1.1):$(uci get 9router.main.port 2>/dev/null || echo 20128)/login" || echo "GAGAL rc=$RC"
exit $RC
